import React, { useState, useEffect, useRef } from 'react';
import { Terminal, Zap, Droplets, TrendingUp, AlertTriangle } from 'lucide-react';

// --- 스킨 및 애니메이션 스타일 ---
const styles = `
  @keyframes flicker {
    0% { opacity: 0.9; } 5% { opacity: 0.8; } 10% { opacity: 0.9; }
    15% { opacity: 0.85; } 25% { opacity: 0.95; } 100% { opacity: 1; }
  }
  .crt-overlay {
    background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%),
                linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
    background-size: 100% 2px, 3px 100%;
    pointer-events: none;
  }
  .scanline {
    width: 100%; height: 100px; z-index: 10;
    background: linear-gradient(0deg, rgba(0,0,0,0) 0%, rgba(0,255,65,0.1) 50%, rgba(0,0,0,0) 100%);
    opacity: 0.1; position: absolute; bottom: 100%; animation: scanline 10s linear infinite;
  }
  @keyframes scanline { 0% { bottom: 100%; } 100% { bottom: -100%; } }
  .matrix-text { text-shadow: 0 0 5px #00FF41; font-family: 'Courier New', monospace; }
`;

export default function ProtocolLingua() {
  const [logs, setLogs] = useState([]);
  const [input, setInput] = useState('');
  const [wallet, setWallet] = useState({ credits: 500, xmr: 0 });
  const [xmrPrice, setXmrPrice] = useState({ price: 241.52, change: 2.4 });
  const [oxygen, setOxygen] = useState(100);
  const scrollRef = useRef(null);

  // 1. 실시간 모네로 시세 시뮬레이션 (원래는 API 호출)
  useEffect(() => {
    const interval = setInterval(() => {
      const vol = (Math.random() - 0.5) * 2;
      setXmrPrice(prev => ({
        price: parseFloat((prev.price + vol).toFixed(2)),
        change: parseFloat(vol.toFixed(2))
      }));
      setOxygen(prev => Math.max(0, prev - 0.5));
    }, 5000);
    return () => clearInterval(interval);
  }, []);

  // 2. 에스페란토 번역 함수 (간이 사전 방식)
  const translateToEsperanto = (text) => {
    const dict = { "안녕": "Saluton", "배고파": "Mi malsatas", "코인": "Kripto", "사랑": "Amo", "가자": "Ni iru" };
    return text.split(' ').map(word => dict[word] || word + "on").join(' ');
  };

  // 3. 메시지 전송 로직
  const handleSubmit = (e) => {
    e.preventDefault();
    if (!input) return;

    const newLog = {
      id: Date.now(),
      sender: "USER_77",
      original: input,
      translated: translateToEsperanto(input),
      time: new Date().toLocaleTimeString(),
      decoded: false
    };

    setLogs(prev => [...prev.slice(-19), newLog]);
    setOxygen(prev => Math.min(100, prev + 5));
    setInput('');
  };

  // 4. 디코딩 (코인 결제)
  const decodeMessage = (id) => {
    const cost = 0.01;
    if (wallet.xmr < cost) return alert("INSUFFICIENT XMR");
    
    setWallet(prev => ({ ...prev, xmr: prev.xmr - cost }));
    setLogs(prev => prev.map(log => log.id === id ? { ...log, decoded: true } : log));
  };

  return (
    <div className="relative min-h-screen bg-black text-[#00FF41] p-4 overflow-hidden select-none">
      <style>{styles}</style>
      <div className="crt-overlay fixed inset-0 z-50"></div>
      <div className="scanline"></div>

      {/* 헤더: 마켓 및 상태창 */}
      <header className="border border-[#00FF41] p-2 mb-4 flex justify-between items-center matrix-text text-xs">
        <div className="flex gap-4">
          <span className="flex items-center gap-1"><TrendingUp size={14}/> XMR: ${xmrPrice.price} ({xmrPrice.change}%)</span>
          <span className="flex items-center gap-1"><Droplets size={14}/> OXYGEN: {oxygen.toFixed(1)}%</span>
        </div>
        <div className="flex gap-4">
          <span>CREDITS: {wallet.credits}</span>
          <span>XMR: {wallet.xmr.toFixed(4)}</span>
        </div>
      </header>

      {/* 메인 로그 영역 */}
      <main className="h-[70vh] border border-[#00FF41] p-4 overflow-y-auto mb-4 custom-scrollbar bg-black/50">
        {logs.length === 0 && <div className="opacity-50 italic">[ NO SIGNAL DETECTED... ]</div>}
        {logs.map((log) => (
          <div key={log.id} className="mb-3 animate-[flicker_0.5s_infinite]">
            <span className="opacity-50">[{log.time}] &lt;{log.sender}&gt;: </span>
            <span className="cursor-help transition-all" onClick={() => decodeMessage(log.id)}>
              {log.decoded ? log.original : log.translated}
            </span>
            {!log.decoded && <span className="text-[10px] ml-2 opacity-30">[CLICK TO DECODE: 0.01 XMR]</span>}
          </div>
        ))}
        <div ref={scrollRef} />
      </main>

      {/* 하단 입력창 */}
      <section className="fixed bottom-6 left-4 right-4">
        <form onSubmit={handleSubmit} className="flex gap-2 items-center">
          <label className="matrix-text shrink-0">C:\USER\LINGUA&gt;</label>
          <input 
            type="text" 
            value={input}
            onChange={(e) => setInput(e.target.value)}
            className="bg-transparent border-none outline-none text-[#00FF41] w-full caret-[#00FF41] matrix-text"
            autoFocus
          />
        </form>
      </section>

      {/* 시스템 경고 (산소 부족 시) */}
      {oxygen < 20 && (
        <div className="fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-[60] bg-red-900/80 border-2 border-red-500 p-8 text-red-500 animate-pulse text-center">
          <AlertTriangle size={48} className="mx-auto mb-4" />
          <h2 className="text-2xl font-bold">SYSTEM CRITICAL</h2>
          <p>OXYGEN LEVEL LOW - LOG DELETION IMMINENT</p>
        </div>
      )}
    </div>
  );
}
